# Copy to production.env in the same machine configuration directory and fill in the values.
QUYET_DESKTOP_APP_ID=com.quyet.quyet
QUYET_DESKTOP_AUTO_UPDATE_ENV=production
QUYET_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
QUYET_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# QUYET_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
QUYET_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
QUYET_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

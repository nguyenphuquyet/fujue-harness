# Copy to production.env and configure the production service before selecting this preset.
QUYET_DESKTOP_APP_ID=com.quyet.quyet
QUYET_DESKTOP_AUTO_UPDATE_ENV=production
QUYET_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
QUYET_DESKTOP_MACOS_PACK_CONCURRENCY=4
QUYET_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
QUYET_DESKTOP_MACOS_DOWNLOAD_PROXY=
QUYET_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# QUYET_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=

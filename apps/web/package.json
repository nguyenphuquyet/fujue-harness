{
  "name": "@quyet/web-frontend",
  "description": "Web application entry: vite build over the @quyet/client-web shell library; dist/ served by apps/cli's quyet web",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @quyet/experimental-webworker-runtime exec tsdown && pnpm --filter @quyet/experimental-webworker-packer exec tsdown && vite build && quyet-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1",
    "render:app-icons": "tsx scripts/render-app-icons.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@quyet/cordis-plugin-group": "workspace:~",
    "@quyet/client-modules": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/llm-mock-server": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-deliverables": "workspace:*",
    "@quyet/client-ui-dockkit": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/client-web": "workspace:*",
    "@quyet/cmdline": "workspace:*",
    "@quyet/pwsh-local": "workspace:*",
    "@quyet/agent-team": "workspace:*",
    "@quyet/experimental-webworker-packer": "workspace:*",
    "@quyet/experimental-webworker-runtime": "workspace:*",
    "@quyet/remote-mock": "workspace:*",
    "@quyet/session-projection-cache": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@quyet/client-ui-theme": "workspace:*",
    "@quyet/launch-environment": "workspace:*",
    "@quyet/workspace-changes": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/experimental-auto-review": "workspace:*",
    "@quyet/experimental-speech-to-text": "workspace:*",
    "@quyet/experimental-voice-input-bundle": "workspace:*",
    "@quyet/experimental-cot-translation-bundle": "workspace:*",
    "@quyet/experimental-worktree": "workspace:*",
    "@quyet/experimental-plugin-market-bundle": "workspace:*",
    "@quyet/experimental-forge-bundle": "workspace:*"
  },
  "dependencies": {
    "@quyet/message-quotes": "workspace:*"
  }
}

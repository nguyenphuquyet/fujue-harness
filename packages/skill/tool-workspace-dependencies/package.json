{
  "name": "@quyet/tool-workspace-dependencies",
  "description": "The load_workspace_dependencies tool: absolute paths into a bundled Python, Node.js, and pnpm payload",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/skill/tool-workspace-dependencies"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  }
}

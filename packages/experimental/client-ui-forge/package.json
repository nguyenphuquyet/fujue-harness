{
  "name": "@quyet/experimental-client-ui-forge",
  "description": "Sidebar panel for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/client-ui-forge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-remotes",
        "@quyet/client-locale",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-layout",
        "@quyet/client-ui-sidebar-right",
        "@quyet/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/experimental-worktree": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/experimental-forge": "workspace:*",
    "@quyet/fs": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "@quyet/util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "^4.4.3",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/api-remotes": "workspace:*",
    "@quyet/api-session-controller": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-sidebar-right": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/client-ui-workspace": "workspace:*",
    "@quyet/experimental-forge": "workspace:*",
    "@quyet/experimental-forge-session": "workspace:*",
    "@quyet/experimental-worktree": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-local": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@quyet/timeout": "workspace:*",
    "@quyet/session-projection-cache": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/api-remote-access": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}

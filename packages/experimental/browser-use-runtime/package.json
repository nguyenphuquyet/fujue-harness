{
  "name": "@quyet/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",

    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/browser-use": "workspace:*",
    "@quyet/mcp-client": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",

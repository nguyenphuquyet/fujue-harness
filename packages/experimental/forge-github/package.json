{
  "name": "@quyet/experimental-forge-github",
  "description": "GitHub provider for the experimental forge registry, read through the GitHub CLI on the host",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/forge-github"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "@quyet/timeout": "workspace:*",
    "execa": "^10.0.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/experimental-forge": "workspace:*",
    "@quyet/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/brand": "workspace:*",
    "@quyet/experimental-forge": "workspace:*",
    "@quyet/subprocess": "workspace:*"
  }
}

{
  "name": "@quyet/hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the JueTech Harness interception seams",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/hook-protocol": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/shell": "workspace:*",
    "@quyet/bash-local": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/hook-protocol": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence-jsonl": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/session-projection": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@quyet/fs-local": "workspace:*"
  }
}

{
  "name": "@quyet/creation-recommendations",
  "description": "Create persistent removable interface plugins from explicit conversation needs",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/creation-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./references/*.md": "./references/*.md",
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/llm": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/skill": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/llm": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/plugin-manager": "workspace:*",
    "@quyet/api-remote-access": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/app-boot": "workspace:*",
    "@quyet/skill": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/tool-testkit": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "resolve.exports": "^2.0.3",
    "zod": "4.4.3",
    "@quyet/client-ui-creation-recommendations": "workspace:*",
    "@quyet/action-cards": "workspace:*",
    "@quyet/client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "references/*.md",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "icon": "./icon.svg"
}

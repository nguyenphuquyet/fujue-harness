{
  "name": "@quyet/experimental-cot-translation-bundle",
  "description": "Experimental machine translation of expanded reasoning",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/cot-translation-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/experimental-translator": "workspace:*",
    "@quyet/experimental-client-ui-cot-translation": "workspace:*"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2"
  },
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

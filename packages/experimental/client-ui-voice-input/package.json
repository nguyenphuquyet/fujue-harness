{
  "name": "@quyet/experimental-client-ui-voice-input",
  "description": "Record speech and insert editable text into the conversation draft",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/client-ui-voice-input"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/api-remotes": "workspace:*",
    "@quyet/api-session-controller": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/experimental-api-speech-to-text": "workspace:*",
    "@quyet/experimental-speech-to-text": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.3",
    "@quyet/api-gateway": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-ui-plugin-manager": "workspace:*"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-remotes",
        "@quyet/api-session-controller",
        "@quyet/client-locale",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-primitives",
        "@quyet/api-gateway",
        "@quyet/client-ui-plugin-manager"
      ],
      "platform": "web",
      "external": [
        "@quyet/api-gateway/client"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}

{
  "name": "@quyet/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on JueTech Harness extension points",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/util-crypto": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/storage-domain": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/user-questions": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/storage": "workspace:*",
    "@quyet/storage-domain": "workspace:*",
    "@quyet/storage-json": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/user-questions": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@quyet/session-persistence-jsonl": "workspace:*"
  }
}

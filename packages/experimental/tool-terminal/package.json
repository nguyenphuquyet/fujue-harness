{
  "name": "@quyet/tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/terminal": "workspace:*",
    "@quyet/output-retention": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/jobs": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/terminal": "workspace:*",
    "@quyet/terminal-bash": "workspace:*",
    "@quyet/output-retention": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/jobs": "workspace:*",
    "@quyet/jobs-local": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tool-jobs": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/session-projection": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  }
}

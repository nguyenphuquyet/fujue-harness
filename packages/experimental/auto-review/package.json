{
  "name": "@quyet/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the JueTech Harness Auto permission preset",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/agent-instructions": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/permission-presets": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/working-directory": "workspace:*"
  },
  "dependencies": {
    "@quyet/util-values": "workspace:*"
  },
  "devDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/agent-instructions": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/bash-sandbox": "workspace:*",
    "@quyet/compaction": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/fs-observation-policy": "workspace:*",
    "@quyet/fs-sandbox": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/llm-deepseek": "workspace:*",
    "@quyet/llm-deepseek-api-key": "workspace:*",
    "@quyet/permission-presets": "workspace:*",
    "@quyet/ptc-runtime-node": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/shell": "workspace:*",
    "@quyet/shell-env": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-bash": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "@quyet/tool-subagent": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/user-approval": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

{
  "name": "@quyet/experimental-inspector",
  "description": "Experimental cross-realm CDP hub for Host debugging and Client Runtime inspection",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "quyet": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/worker.js",
    "lib/devtools/**",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/app-boot": "workspace:*",
    "@quyet/util-crypto": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "open": "^11.0.2",
    "serve-static": "^2.2.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "chrome-devtools-frontend": "1.0.1638082",
    "@types/serve-static": "^2.2.0",
    "@quyet/client-test-runtime": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "@quyet/client-shortcuts": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "react": "^18.2.0",
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/host-webserver": "workspace:*",
    "@quyet/cmdline": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@types/ws": "^8.18.1",
    "playwright": "^1.49.0",
    "tsx": "^4.23.13",
    "@quyet/brand": "workspace:*",
    "@quyet/client-modules": "workspace:*"
  }
}

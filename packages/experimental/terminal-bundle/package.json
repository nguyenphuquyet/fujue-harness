{
  "name": "@quyet/experimental-terminal-bundle",
  "description": "Keep shell processes alive across tool calls.",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/terminal-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@quyet/tool-terminal": "workspace:*",
    "@quyet/terminal": "workspace:*",
    "@quyet/terminal-bash": "workspace:*"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~"
  }
}

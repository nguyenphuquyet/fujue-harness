{
  "name": "@quyet/experimental-client-ui-stats",
  "description": "Per-turn and per-step context, timing, cache, and tool-cost table contributed as an experimental conversation View",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/client-ui-stats"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-session-controller",
        "@quyet/client-locale",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent-team": "workspace:*",
    "@quyet/api-session-controller": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/llm-retry": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@quyet/compaction": "workspace:*",
    "@quyet/session-stats": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/user-approval": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

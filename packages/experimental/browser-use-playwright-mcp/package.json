{
  "name": "@quyet/experimental-browser-use-playwright-mcp",
  "description": "Experimental per-Session Chromium browser tools through @playwright/mcp",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/browser-use-playwright-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/experimental-browser-use-runtime": "workspace:*",
    "@playwright/mcp": "0.0.80"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/browser-use": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/browser-use": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  }
}

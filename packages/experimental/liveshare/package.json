    "@quyet/client-ui-approval": "workspace:*",
    "@quyet/client-ui-attachment": "workspace:*",
    "@quyet/client-ui-brand-official": "workspace:*",
    "@quyet/client-ui-chat": "workspace:*",
    "@quyet/client-ui-commands": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-deliverables": "workspace:*",
    "@quyet/client-ui-input-trigger": "workspace:*",
    "@quyet/client-ui-jobs": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "@quyet/client-ui-plan": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-reference": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-settings": "workspace:*",
    "@quyet/client-ui-sidebar": "workspace:*",
    "@quyet/client-ui-sidebar-right": "workspace:*",

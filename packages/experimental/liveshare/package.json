{
  "name": "@quyet/experimental-liveshare",
  "description": "Opt-in LiveShare host bundle: share a Session through a separate Relay at the view or bounded-write tier, with forking and attachment uploads as independent switches",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/liveshare"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/share-api-types.d.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/owner-gateway/cli.js",
    "lib/retry-backoff-*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@quyet/atomic-write": "workspace:*",
    "@quyet/brand": "workspace:*",
    "@quyet/experimental-liveshare-protocol": "workspace:*",
    "@quyet/http-proxy": "workspace:*",
    "@quyet/official-bundles": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "undici": "8.11.2",
    "ws": "^8.18.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/scope": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/api-gateway": "workspace:*",
    "@quyet/api-remote-access": "workspace:*",

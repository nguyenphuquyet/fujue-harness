    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/fs-observation-policy": "workspace:*",
    "@quyet/fs-sandbox": "workspace:*",
    "@quyet/host-webserver": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/typert-registry": "workspace:*",
    "@quyet/workspace": "workspace:*",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    },
    "client": {
      "inject": [
        "@quyet/api-remote-access",
        "@quyet/api-remotes",
        "@quyet/client-locale",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-primitives",
        "@quyet/client-ui-renderer",
        "@quyet/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@quyet/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/QuyetComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/computer-use": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/user-questions": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@quyet/atomic-write": "workspace:*",
    "@quyet/cua": "workspace:*"
  },
  "devDependencies": {
    "@quyet/working-directory": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/attachment-local": "workspace:*",
    "@quyet/computer-use": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm-deepseek": "workspace:*",
    "@quyet/ptc-runtime-node": "workspace:*",
    "@quyet/sandbox-local": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@quyet/ptc-runtime": "workspace:*",
    "@quyet/user-questions": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/app-boot": "workspace:*",
    "@quyet/config-editor": "workspace:*",
    "@quyet/hmr": "workspace:*",
    "@quyet/cordis-plugin-timer": "workspace:~",
    "@quyet/storage": "workspace:*",
    "@quyet/storage-json": "workspace:*",
    "@quyet/storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}

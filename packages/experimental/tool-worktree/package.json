{
  "name": "@quyet/experimental-tool-worktree",
  "description": "Model tool that creates and enters a new Git worktree",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/experimental/tool-worktree"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/tools": "workspace:*",
    "@quyet/experimental-worktree": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-local": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@quyet/experimental-worktree": "workspace:*",
    "@quyet/agent-loop": "workspace:*"
  },
  "icon": "./icon.svg",
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@quyet/experimental-worktree": "workspace:*"
  }
}

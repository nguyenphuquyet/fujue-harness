{
  "name": "@quyet/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process JueTech Harness SDK clients",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/brand": "workspace:*",
    "@quyet/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/goal": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/llm-deepseek-api-key": "workspace:*",
    "@quyet/schedule": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/sdk-protocol": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/user-approval": "workspace:*",
    "@quyet/user-questions": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/command-compact": "workspace:*",
    "@quyet/command-goal": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/compaction-basic": "workspace:*",

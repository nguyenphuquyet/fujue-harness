{
  "name": "@quyet/sdk-client",
  "description": "TypeScript client SDK for driving a JueTech Harness runtime subprocess over stdio JSON-RPC: the QuyetHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/harness": "workspace:*"
  },
  "peerDependencies": {
    "@quyet/llm": "workspace:*",
    "@quyet/sdk-protocol": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/llm": "workspace:*",
    "@quyet/sdk-protocol": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/experimental-translator": "workspace:*"
  }
}

{
  "name": "@deepseek-ai/dsh-fujue-account",
  "description": "Sign in to FuJue Harness through a device code and apply the account's model configuration",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/fujue-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/ja.json": "./locale/ja.json",
    "./locale/es.json": "./locale/es.json",
    "./locale/fr.json": "./locale/fr.json",
    "./locale/de.json": "./locale/de.json",
    "./locale/ru.json": "./locale/ru.json",
    "./locale/pt.json": "./locale/pt.json",
    "./locale/vi.json": "./locale/vi.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/en.json",
    "locale/zh.json",
    "locale/ja.json",
    "locale/es.json",
    "locale/fr.json",
    "locale/de.json",
    "locale/ru.json",
    "locale/pt.json",
    "locale/vi.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent-default-model": "workspace:*",
    "@deepseek-ai/dsh-authorization": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent-default-model": "workspace:*",
    "@deepseek-ai/dsh-authorization": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  }
}

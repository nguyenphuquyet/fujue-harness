{
  "name": "@quyet/deepseek-account",
  "description": "Read account state and resolve official API credentials",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/credentials/deepseek-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/brand": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/util-values": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/brand": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/agent": {
      "optional": true
    }
  }
}

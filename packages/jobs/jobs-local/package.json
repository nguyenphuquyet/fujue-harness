{
  "name": "@quyet/jobs-local",
  "description": "Process-local implementation of the JueTech Harness background job registry seam",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/jobs": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/brand": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/jobs": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/cordis": "workspace:~"
  }
}

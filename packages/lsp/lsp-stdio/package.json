{
  "name": "@quyet/lsp-stdio",
  "description": "Generic stdio language-server provider for the JueTech Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/brand": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/lsp": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/timeout": "workspace:*"
  },
  "dependencies": {
    "@quyet/util-values": "workspace:*",
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/brand": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/lsp": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}

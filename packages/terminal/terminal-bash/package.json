{
  "name": "@quyet/terminal-bash",
  "description": "Persistent shell PTY backend over the JueTech Harness subprocess terminal primitive",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/terminal": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/working-directory": "workspace:*"
  },
  "dependencies": {
    "@quyet/lazy-require": "workspace:*",
    "@quyet/pwsh-local": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/terminal": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/working-directory": "workspace:*"
  }
}

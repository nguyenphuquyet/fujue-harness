{
  "name": "@quyet/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the JueTech Harness web capability seam (ctx.web)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/credentials": "workspace:*",
    "@quyet/deepseek-account": "workspace:*",
    "@quyet/launch-environment": "workspace:*",
    "@quyet/llm-deepseek": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/web": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/credentials": "workspace:*",
    "@quyet/credentials-local": "workspace:*",
    "@quyet/deepseek-account": "workspace:*",
    "@quyet/launch-environment": "workspace:*",
    "@quyet/llm-deepseek": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/web": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/deepseek-account": {
      "optional": true
    }
  }
}

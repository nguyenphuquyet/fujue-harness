{
  "name": "@quyet/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the JueTech Harness web capability seam (ctx.web)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/llm": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/web": "workspace:*"
  },
  "dependencies": {
    "@quyet/output-retention": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/spill-local": "workspace:*",
    "@quyet/spill-policy": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-call-timeout-policy": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/web": "workspace:*",
    "@quyet/web-deepseek-api": "workspace:*",
    "@quyet/web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@quyet/scope": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/launch-environment": "workspace:*"
  }
}

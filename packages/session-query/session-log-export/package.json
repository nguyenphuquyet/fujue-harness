{
  "name": "@quyet/session-log-export",
  "description": "Web Session-log ZIP export and Session Markdown copy",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/session-query/session-log-export"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@quyet/session-format": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "fflate": "^0.8.2",
    "@quyet/brand": "workspace:*"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-ui-commands": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "@quyet/client-ui-message-feedback": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/session-title": "workspace:*",
    "react": "^18.2.0"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/client-locale",
        "@quyet/client-ui-commands",
        "@quyet/client-ui-context-menu",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-layout",
        "@quyet/client-ui-renderer"
      ],
      "platform": "web"
    }
  }
}

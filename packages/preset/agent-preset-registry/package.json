{
  "name": "@quyet/agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "dependencies": {
    "@quyet/app-boot": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "zod": "4.4.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@quyet/cordis-plugin-group": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/atomic-write": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/fs-local": "workspace:*",
    "@quyet/hmr": "workspace:*",
    "@quyet/ptc-runtime": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/user-approval": "workspace:*",
    "@quyet/agent-preset": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}

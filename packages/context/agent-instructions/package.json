{
  "name": "@quyet/agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/home-paths": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  },
  "dependencies": {
    "@quyet/util-values": "workspace:*",
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/home-paths": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/llm-deepseek": "workspace:*",
    "@quyet/llm-deepseek-api-key": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  }
}

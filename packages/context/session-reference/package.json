{
  "name": "@quyet/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/brand": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/compaction": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/output-retention": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/session-projection-cache": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/session-title": "workspace:*",
    "@quyet/spill": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/spill": {
      "optional": true
    },
    "@quyet/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/compaction": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/output-retention": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/session-projection-cache": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/session-query-sqlite": "workspace:*",
    "@quyet/session-title": "workspace:*",
    "@quyet/spill": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/spill-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  }
}

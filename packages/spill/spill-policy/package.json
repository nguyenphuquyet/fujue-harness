{
  "name": "@quyet/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/llm": "workspace:*",
    "@quyet/output-retention": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/spill": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/attachment": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/token-meter": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/ptc-runtime-node": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/output-retention": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/spill": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/fs-local": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/sandbox-local": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/mcp-client": "workspace:*",
    "@quyet/spill-local": "workspace:*",
    "@quyet/llm-deepseek": "workspace:*",
    "@quyet/ptc-runtime": "workspace:*",
    "@quyet/attachment-local": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "sharp": "0.35.5",
    "@quyet/agent-loop-testkit": "workspace:*"
  }
}

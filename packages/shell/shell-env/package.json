{
  "name": "@quyet/shell-env",
  "description": "Tool-independent managed QUYET_* shell environment registry",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/shell/shell-env"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/app-boot": "workspace:*",
    "@quyet/home-paths": "workspace:*",
    "@quyet/shell": "workspace:*",
    "@quyet/tools": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/app-boot": "workspace:*",
    "@quyet/home-paths": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/shell": "workspace:*",
    "@quyet/tools": "workspace:*"
  }
}

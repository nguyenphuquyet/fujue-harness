{
  "name": "@quyet/bash-sandbox",
  "description": "Sandbox-consuming implementation of the JueTech Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/shell": "workspace:*",
    "@quyet/bash-local": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/shell": "workspace:*",
    "@quyet/bash-local": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/sandbox": "workspace:*",
    "@quyet/sandbox-local": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/node-addon-system": "workspace:~",
    "@quyet/session-projection": "workspace:*"
  }
}

{
  "name": "@quyet/workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons, for the JueTech Harness",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/fs": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tool-str-replace-editor": "workspace:*",
    "@quyet/fs-observation-policy": "workspace:*",
    "@quyet/system-prompt": "workspace:*"
  }
}

{
  "name": "@quyet/deliverable-file-references",
  "description": "Shared model guidance for file links and deliverables across JueTech Harness hosts",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/deliverables/deliverable-file-references"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/system-prompt": "workspace:*"
  }
}

{
  "name": "@quyet/tool-todo",
  "description": "Model-facing todo_write tool over the JueTech Harness event-sourced session log",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/todo/tool-todo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@quyet/agent": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis-plugin-include": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/user-questions": "workspace:*",
    "@quyet/cordis": "workspace:~"
  }
}

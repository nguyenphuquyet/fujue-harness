{
  "name": "@quyet/acp",
  "description": "Automation-only Agent Client Protocol server for driving JueTech Harness agents over JSON-RPC stdio",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@quyet/brand": "workspace:*",
    "@quyet/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/mcp-client": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/mcp-client": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence": "workspace:*",
    "@quyet/session-persistence-jsonl": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/user-approval": "workspace:*"
  }
}

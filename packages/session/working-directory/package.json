{
  "name": "@quyet/working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/user-approval": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tool-working-directory": "workspace:*",
    "@quyet/tools": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}

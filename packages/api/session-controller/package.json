{
  "name": "@quyet/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "external": [
        "@quyet/api-gateway/client"
      ],
      "inject": [
        "@quyet/api-gateway",
        "@quyet/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@quyet/brand": "workspace:*",
    "@quyet/deque": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-default-model": "workspace:*",
    "@quyet/agent-preset-registry": "workspace:*",
    "@quyet/api-gateway": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@quyet/client-file-upload": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/credentials": "workspace:*",
    "@quyet/file-reference": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/native-command": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/session-projection-cache": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/session-title": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/skill": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/typert-registry": "workspace:*",
    "@quyet/util-time": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@quyet/workspace": "workspace:*",
    "@quyet/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/session-persistence": {
      "optional": true
    },
    "@quyet/session-projection-cache": {
      "optional": true
    },
    "@quyet/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quyet/api-remote-access": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-default-model": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/agent-preset-registry": "workspace:*",
    "@quyet/api-gateway": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/attachment-local": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@quyet/client-file-upload": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/credentials": "workspace:*",
    "@quyet/file-reference": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/native-command": "workspace:*",
    "@quyet/permission-presets": "workspace:*",
    "@quyet/remote-mock": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-persistence": "workspace:*",
    "@quyet/session-persistence-jsonl": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/session-projection-cache": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/session-title": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/skill": "workspace:*",
    "@quyet/storage": "workspace:*",
    "@quyet/storage-domain": "workspace:*",
    "@quyet/storage-json": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/typert-protocol": "workspace:*",
    "@quyet/typert-registry": "workspace:*",
    "@quyet/util-crypto": "workspace:*",
    "@quyet/util-time": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@quyet/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@quyet/working-directory": "workspace:*"
  }
}

{
  "name": "@quyet/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/timeout": "workspace:*"
  },
  "dependencies": {
    "@quyet/brand": "workspace:*",
    "@quyet/sdk-protocol": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@quyet/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/app-boot": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/loader-smoke": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-checkpoint-policy": "workspace:*",
    "@quyet/session-persistence-jsonl": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/tool-jobs": "workspace:*",
    "@quyet/tools": "workspace:*"
  },
  "icon": "./icon.svg"
}

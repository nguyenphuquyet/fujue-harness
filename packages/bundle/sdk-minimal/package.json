{
  "name": "@quyet/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@quyet/cordis-plugin-timer": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/attachment-local": "workspace:*",
    "@quyet/compaction-basic": "workspace:*",
    "@quyet/compaction-image-offload": "workspace:*",
    "@quyet/deepseek-llm-api-extensions": "workspace:*",
    "@quyet/jobs-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/llm-deepseek-api-key": "workspace:*",
    "@quyet/llm-retry": "workspace:*",
    "@quyet/mcp-resources": "workspace:*",
    "@quyet/plugin-package-inventory-deepseek": "workspace:*",
    "@quyet/sandbox-local": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/sdk-app": "workspace:*",
    "@quyet/sdk-jsonrpc-server": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-checkpoint-policy": "workspace:*",
    "@quyet/session-log-deepseek": "workspace:*",
    "@quyet/session-persistence-jsonl": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/session-title": "workspace:*",
    "@quyet/subprocess-local": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/terminal": "workspace:*",
    "@quyet/terminal-bash": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/tool-bash-persistent": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-fs": "workspace:*",
    "@quyet/tool-pwsh-persistent": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/working-directory": "workspace:*",
    "@quyet/tool-working-directory": "workspace:*",
    "@quyet/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~"
  }
}

{
  "name": "@quyet/headless",
  "description": "The quyet one-shot bundle: a direct core Agent/Session runner over quyet-base with no Host, HTTP, or browser layer",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "quyet": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@quyet/brand": "workspace:*",
    "@quyet/cmdline": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-default-model": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/permission-presets": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/user-approval": "workspace:*"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/cordis-plugin-loader": "workspace:~",
    "@quyet/agent": "workspace:*",
    "@quyet/agent-default-model": "workspace:*",
    "@quyet/agent-loop": "workspace:*",
    "@quyet/agent-loop-testkit": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/permission-presets": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/subagent": "workspace:*",
    "@quyet/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/permission-presets": {
      "optional": true
    },
    "@quyet/sandbox-policy": {
      "optional": true
    },
    "@quyet/subagent": {
      "optional": true
    }
  }
}

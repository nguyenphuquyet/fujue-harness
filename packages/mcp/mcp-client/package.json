{
  "name": "@quyet/mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@quyet/attachment": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/mcp-resources": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/credentials": "workspace:*"
  },
  "dependencies": {
    "@quyet/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@quyet/util-values": "workspace:*"
  },
  "devDependencies": {
    "@quyet/attachment": "workspace:*",
    "@quyet/attachment-local": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/scope": "workspace:*",
    "@quyet/subprocess": "workspace:*",
    "@quyet/timeout": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@quyet/cordis": "workspace:~",
    "@quyet/http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.4.3",
    "@quyet/mcp-resources": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/credentials": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quyet/mcp-resources": {
      "optional": true
    },
    "@quyet/system-prompt": {
      "optional": true
    },
    "@quyet/credentials": {
      "optional": true
    }
  }
}

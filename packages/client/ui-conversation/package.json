{
  "name": "@quyet/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-session-controller",
        "@quyet/client-file-upload",
        "@quyet/client-locale",
        "@quyet/client-ui-layout",
        "@quyet/client-ui-renderer",
        "@quyet/client-ui-session",
        "@quyet/client-ui-settings",
        "@quyet/client-ui-workspace",
        "@quyet/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/api-remotes": "workspace:*",
    "@quyet/api-session-controller": "workspace:*",
    "@quyet/api-workspace-controller": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-file-upload": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-settings": "workspace:*",
    "@quyet/client-ui-workspace": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/commands": "workspace:*",
    "@quyet/goal": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/llm-retry": "workspace:*",
    "@quyet/plan-mode": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/tool-todo": "workspace:*",
    "@quyet/util-crypto": "workspace:*",
    "@quyet/workspace": "workspace:*",
    "@quyet/file-reference": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@quyet/agent": "workspace:*",
    "@quyet/settings": "workspace:*",
    "@quyet/client-shortcuts": "workspace:*",
    "@quyet/client-product-analytics": "workspace:*",
    "@quyet/message-quotes": "workspace:*",
    "@quyet/session-projection": "workspace:*",
    "@quyet/brand": "workspace:*",
    "zod": "4.4.3",
    "@quyet/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

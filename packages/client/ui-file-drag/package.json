{
  "name": "@quyet/client-ui-file-drag",
  "description": "Application-owned file drag transfers and localized failure feedback",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-file-drag"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "react": "^18.2.0",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/util-file-drag": "workspace:*",
    "@quyet/util-crypto": "workspace:*",
    "@quyet/client-locale": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

{
  "name": "@quyet/client-ui-attachment",
  "description": "Dynamic attachment presentation plugin for conversation input, message-image, and trajectory image slots",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-attachment"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/client-locale",
        "@quyet/client-ui-chat",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-renderer",
        "@quyet/client-ui-trajectory",
        "@quyet/client-ui-tool",
        "@quyet/client-ui-file-drag",
        "@quyet/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-ui-chat": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-trajectory": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@quyet/attachment": "workspace:*",
    "@quyet/client-ui-tool": "workspace:*",
    "clsx": "^2.0.0",
    "@quyet/client-ui-file-drag": "workspace:*",
    "@quyet/util-file-drag": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  }
}

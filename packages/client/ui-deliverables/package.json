{
  "name": "@quyet/client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-remotes",
        "@quyet/client-connection",
        "@quyet/client-locale",
        "@quyet/client-ui-chat",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-renderer",
        "@quyet/client-ui-sidebar-right",
        "@quyet/client-ui-tool",
        "@quyet/client-ui-settings",
        "@quyet/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/api-remotes": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-chat": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-dockkit": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-sidebar-right": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "react": "^18.2.0",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/session-query": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/client-ui-tool": "workspace:*",
    "@quyet/tool-present": "workspace:*",
    "@quyet/workspace-changes": "workspace:*",
    "@quyet/api-session-controller": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@quyet/api-workspace-files": "workspace:*",
    "@quyet/fs": "workspace:*",
    "@quyet/fs-local": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/sandbox-policy": "workspace:*",
    "@quyet/client-ui-settings": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@quyet/typert-protocol": "workspace:*"
  }
}

{
  "name": "@quyet/client-ui-open-in-app",
  "description": "Session application submenus and native opening controls for directories and previewed files",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-open-in-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-gateway",
        "@quyet/api-remotes",
        "@quyet/api-session-controller",
        "@quyet/client-locale",
        "@quyet/client-shortcuts",
        "@quyet/client-ui-conversation",
        "@quyet/client-ui-layout",
        "@quyet/client-ui-renderer",
        "@quyet/client-ui-session",
        "@quyet/client-ui-sidebar-documentpreview",
        "@quyet/client-ui-context-menu",
        "@quyet/client-ui-sidebar-right",
        "@quyet/api-workspace-files",
        "@quyet/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/api-gateway": "workspace:*",
    "@quyet/api-remotes": "workspace:*",
    "@quyet/api-session-controller": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-layout": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-sidebar-documentpreview": "workspace:*",
    "@quyet/client-ui-sidebar-files": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/host-open-in-app": "workspace:*",
    "@quyet/session": "workspace:*",
    "react": "^18.2.0",
    "@quyet/client-ui-deliverables": "workspace:*",
    "@quyet/native-command": "workspace:*",
    "@quyet/client-shortcuts": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*",
    "@quyet/client-ui-file-actions": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@quyet/client-ui-sidebar-right": "workspace:*",
    "@quyet/api-workspace-files": "workspace:*",
    "@quyet/client-ui-sidebar-browser": "workspace:*",
    "@quyet/client-ui-workspace": "workspace:*"
  }
}

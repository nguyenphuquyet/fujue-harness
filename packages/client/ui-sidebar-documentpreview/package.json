{
  "name": "@quyet/client-ui-sidebar-documentpreview",
  "description": "Extensible Sidebar previews for Office documents, spreadsheets, Markdown, code, images, PDF, HTML, and plain text",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-sidebar-documentpreview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-gateway",
        "@quyet/api-workspace-files",
        "@quyet/client-resources",
        "@quyet/client-ui-sidebar-right",
        "@quyet/client-ui-session",
        "@quyet/api-remotes",
        "@quyet/client-locale",
        "@quyet/client-ui-settings",
        "@quyet/client-ui-file-drag",
        "@quyet/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/cordis": "workspace:~",
    "@quyet/api-gateway": "workspace:*",
    "@quyet/api-remotes": "workspace:*",
    "@quyet/api-workspace-files": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-resources": "workspace:*",
    "@quyet/client-store": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-dockkit": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/client-ui-settings": "workspace:*",
    "@quyet/client-ui-sidebar-files": "workspace:*",
    "@quyet/client-ui-sidebar-right": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@quyet/office-to-pdf": "workspace:*",
    "@quyet/host-webserver": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@testing-library/react": "^16.3.3",
    "@types/papaparse": "^5.3.16",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.16",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "^0.8.3",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0",
    "@quyet/client-ui-file-drag": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@quyet/schemastery": "workspace:~"
  }
}

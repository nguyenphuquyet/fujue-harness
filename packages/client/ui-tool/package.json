{
  "name": "@quyet/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenphuquyet/quyet-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "quyet": {
    "client": {
      "inject": [
        "@quyet/api-workspace-controller",
        "@quyet/client-connection",
        "@quyet/client-locale",
        "@quyet/client-ui-conversation",
        "@quyet/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@quyet/cordis": "workspace:~"
  },
  "devDependencies": {
    "@quyet/spill-policy": "workspace:*",
    "@quyet/fs-patch": "workspace:*",
    "@quyet/agent": "workspace:*",
    "@quyet/llm": "workspace:*",
    "@quyet/session": "workspace:*",
    "@quyet/system-prompt": "workspace:*",
    "@quyet/tool-testkit": "workspace:*",
    "@quyet/tools": "workspace:*",
    "@quyet/tool-executor-native": "workspace:*",
    "@quyet/tool-executor-ptc": "workspace:*",
    "@quyet/tool-jobs": "workspace:*",
    "@quyet/tool-session-query": "workspace:*",
    "@quyet/tool-terminal": "workspace:*",
    "@quyet/spill": "workspace:*",
    "@quyet/cordis": "workspace:~",
    "@quyet/api-remotes": "workspace:*",
    "@quyet/client-connection": "workspace:*",
    "@quyet/client-locale": "workspace:*",
    "@quyet/client-test-runtime": "workspace:*",
    "@quyet/client-ui-conversation": "workspace:*",
    "@quyet/client-ui-primitives": "workspace:*",
    "@quyet/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@quyet/api-workspace-controller": "workspace:*",
    "@quyet/client-ui-chat": "workspace:*",
    "@quyet/client-ui-renderer": "workspace:*",
    "@quyet/client-ui-session": "workspace:*",
    "@quyet/util-values": "workspace:*",
    "@quyet/util-workspace-path": "workspace:*",
    "@quyet/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@quyet/ptc-runtime": "workspace:*",
    "@quyet/token-meter": "workspace:*",
    "@quyet/user-questions": "workspace:*",
    "@quyet/client-ui-context-menu": "workspace:*",
    "@quyet/api-session-controller": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
